POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Applies to future indexing jobs; reindex documents after changing these.
CHUNK_SIZE=120
CHUNK_OVERLAP=16

# Model changes require a compatible 384-dimensional embedding and reindexing.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
MAX_UPLOAD_SIZE=10000000
LOG_LEVEL=INFO
MAX_CHUNKS_PER_DOCUMENT=5000
